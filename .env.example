# Yerel analiz için bir sağlayıcı seçin. Gerçek anahtarlar yalnızca .env.local içine yazılır.
# Vercel AI Gateway:
JEV_PROVIDER=gateway
AI_GATEWAY_API_KEY=

# Alternatif: JEV_PROVIDER=typesafe yapıp aşağıdaki anahtarı doldurun.
TYPESAFE_API_KEY=

# Sunucu örneği başına en iyi çaba sınırlarıdır; küresel harcama sınırı değildir.
ANALYSES_PER_HOUR=20
LENSES_PER_HOUR=60
